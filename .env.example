# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — SaaS API Monitor
# ==============================================================================
# Copy this file to .env.local (inside apps/web/) to run the application locally.
#
# QUICK START — Demo Mode (zero external dependencies):
#   1. cp .env.example apps/web/.env.local
#   2. Set NEXT_PUBLIC_USE_MOCK=true in .env.local
#   3. pnpm install && pnpm dev
#   → The app runs at http://localhost:3000 with in-memory simulated datasets.
#
# LOCAL FULL STACK — With PostgreSQL and Redis (Docker) and app on host:
#   1. cp .env.example apps/web/.env.local
#   2. Set NEXT_PUBLIC_USE_MOCK=false and configure the variables below
#   3. docker compose up -d postgres redis
#   4. pnpm --filter @monitor/db db:migrate
#   5. pnpm dev
#
# CONTAINERIZED FULL STACK — All services in Docker (Next.js, Worker, Postgres, Redis):
#   1. cp .env.example .env
#   2. Set NEXT_PUBLIC_USE_MOCK=false and generate an ENCRYPTION_KEY
#   3. docker compose up -d
#   4. pnpm --filter @monitor/db db:migrate
# ==============================================================================

# Enable/Disable Mock Mode (when true, uses in-memory mock gateways;
# does not require database, Redis, or external API keys).
# Values: true | false
NEXT_PUBLIC_USE_MOCK=true

# ------------------------------------------------------------------------------
# Required only when NEXT_PUBLIC_USE_MOCK=false
# ------------------------------------------------------------------------------

# PostgreSQL connection string (defaults match local docker-compose.yml)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/apimonitor

# Redis connection URL for BullMQ queues
# Example with local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# AES-256-GCM cryptographic key for the Credential Vault.
# Required when NEXT_PUBLIC_USE_MOCK=false. 64-character hexadecimal string (32 bytes).
# Generate a secure key by running:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Optional notification variables (work with or without mock mode)
# ------------------------------------------------------------------------------

# Resend API key for outbound email notifications.
# Leave empty to disable email notifications (does not block startup).
# Obtain an API key at: https://resend.com
RESEND_API_KEY=

# Sender email address for outgoing notifications
FROM_EMAIL=API Monitor <alerts@apimonitor.dev>
